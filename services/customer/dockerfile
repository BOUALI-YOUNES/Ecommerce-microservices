# ---- Runtime image (jar is built on the host) ----
# The heap is pinned with an explicit -Xmx instead of MaxRAMPercentage. A percentage
# is resolved against whatever the JVM believes the machine has: with no mem_limit in
# compose the gateway, config-server and discovery each sized themselves against the
# whole Docker VM and committed gigabytes at boot, which is what drove the OOM kills.
# An explicit value is identical on every host and cannot drift.
#
# The container limit (mem_limit in docker-compose.yml) must stay comfortably above
# heap + metaspace + code cache + thread stacks + direct buffers, so MaxMetaspaceSize
# and ReservedCodeCacheSize are bounded too rather than left to grow unchecked.
# ExitOnOutOfMemoryError makes the JVM die fast and be restarted by the restart policy
# instead of limping along in an unusable state.
FROM eclipse-temurin:21
WORKDIR /app
COPY target/*.jar app.jar
ENTRYPOINT ["java","-Xms64m","-Xmx288m","-XX:MaxMetaspaceSize=160m","-XX:ReservedCodeCacheSize=48m","-XX:+ExitOnOutOfMemoryError","-jar","app.jar"]