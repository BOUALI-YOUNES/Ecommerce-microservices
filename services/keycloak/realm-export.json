{
  "realm": "ecom-realm",
  "enabled": true,
  "displayName": "Ecom",
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      {
        "name": "USER",
        "description": "Regular user",
        "composite": false,
        "clientRole": false,
        "containerId": "ecom-realm"
      },
      {
        "name": "ADMIN",
        "description": "Administrator",
        "composite": false,
        "clientRole": false,
        "containerId": "ecom-realm"
      },
      {
        "name": "SERVICE",
        "description": "Service-to-service identity used for internal callbacks such as stock release. Never assignable to end users."
      }
    ]
  },
  "clients": [
    {
      "clientId": "ecom-frontend",
      "name": "Ecom Frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "redirectUris": [
        "*"
      ],
      "webOrigins": [
        "*"
      ]
    },
    {
      "clientId": "ecom-order-service",
      "name": "Order Service (service-to-service)",
      "enabled": true,
      "publicClient": false,
      "secret": "order-service-dev-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "attributes": {
        "access.token.lifespan": "300"
      }
    }
  ],
  "users": [
    {
      "username": "user",
      "enabled": true,
      "firstName": "Regular",
      "lastName": "User",
      "email": "user@ecom.local",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "user123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER"
      ]
    },
    {
      "username": "admin",
      "enabled": true,
      "firstName": "Admin",
      "lastName": "User",
      "email": "admin@ecom.local",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER",
        "ADMIN"
      ]
    },
    {
      "username": "service-account-ecom-order-service",
      "enabled": true,
      "serviceAccountClientId": "ecom-order-service",
      "realmRoles": [
        "SERVICE"
      ]
    }
  ]
}
