POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
MONGO_USER=mongo-admin
MONGO_PASSWORD=change-me-mongo
MAIL_USER=maildev
MAIL_PASSWORD=change-me-mail

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin

# Service-to-service credential for the order service. Only the order service uses this;
# end users never get it, so internal product endpoints can be restricted to it.
#
# Leave this as change-me and run ./init-secrets.sh, which fills in a random 32-byte
# value. It is deliberately NOT committed: the realm import in keycloak/realm-export.json
# carries a "${ORDER_SERVICE_CLIENT_SECRET}" placeholder and Keycloak substitutes this
# value at boot, so the credential exists only in your gitignored .env.
ORDER_SERVICE_CLIENT_ID=ecom-order-service
ORDER_SERVICE_CLIENT_SECRET=change-me-order-service-secret
