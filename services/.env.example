POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
MONGO_USER=mongo-admin
MONGO_PASSWORD=change-me-mongo
MAIL_USER=maildev
MAIL_PASSWORD=change-me-mail

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin

# Service-to-service credential for the order service. Must match the secret of the
# ecom-order-service client in keycloak/realm-export.json. Only the order service uses
# this; end users never get it, so internal product endpoints can be restricted to it.
ORDER_SERVICE_CLIENT_ID=ecom-order-service
ORDER_SERVICE_CLIENT_SECRET=change-me-order-service-secret
